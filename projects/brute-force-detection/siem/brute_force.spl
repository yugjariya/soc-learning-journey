index=ssh_lab sourcetype="bf:ssh" "Failed password"
| rex field=_raw "^\S+\s+(?<dest>\S+)\s+sshd(?:-session)?(?:\[\d+\])?:\s+Failed password for (?:invalid user )?(?<user>\S+) from (?<src_ip>\S+) port \d+ ssh2"
| where isnotnull(dest) AND isnotnull(user) AND isnotnull(src_ip)
| sort 0 + _time
| streamstats time_window=5m count AS failures min(_time) AS window_start BY dest src_ip user
| where failures >= 5
| table _time window_start dest src_ip user failures _raw
