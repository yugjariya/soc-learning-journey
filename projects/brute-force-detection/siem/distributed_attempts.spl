index=ssh_lab sourcetype="bf:ssh" "Failed password"
| rex field=_raw "^\S+\s+(?<dest>\S+)\s+sshd(?:-session)?(?:\[\d+\])?:\s+Failed password for (?:invalid user )?(?<user>\S+) from (?<src_ip>\S+) port \d+ ssh2"
| where isnotnull(dest) AND isnotnull(user) AND isnotnull(src_ip)
| sort 0 + _time
| streamstats time_window=5m dc(src_ip) AS distinct_sources count AS failures values(src_ip) AS source_addresses BY dest user
| where failures >= 5 AND distinct_sources >= 3
| table _time dest user distinct_sources failures source_addresses _raw
